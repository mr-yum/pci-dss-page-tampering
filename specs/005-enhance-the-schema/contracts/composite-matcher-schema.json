{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mr-yum/pci-dss-page-tampering/specs/005-enhance-the-schema/composite-matcher-schema.json",
  "title": "Composite Matcher Schema",
  "description": "JSON Schema for composite matchers (OR/AND logic) with nested authorization metadata for PCI DSS script inventory",
  "version": "1.0.0",
  "definitions": {
    "authorisationInfo": {
      "type": "object",
      "description": "Authorization metadata with justification, status, and timestamp",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable justification for authorization decision"
        },
        "authorised": {
          "type": "boolean",
          "description": "Authorization status (true = authorized, false = explicitly denied)"
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of authorization decision"
        }
      },
      "required": ["description", "authorised", "date"],
      "additionalProperties": false
    },
    "nameMatcherConfig": {
      "type": "object",
      "description": "Matches scripts by URL using regex pattern (case-sensitive)",
      "properties": {
        "nameMatcher": {
          "type": "string",
          "minLength": 1,
          "description": "Regex pattern for script URL (e.g., '^https://cdn\\.example\\.com/.*')"
        }
      },
      "required": ["nameMatcher"],
      "additionalProperties": false
    },
    "headerNameMatcherConfig": {
      "type": "object",
      "description": "Matches headers by name using regex pattern (case-insensitive per RFC 7230)",
      "properties": {
        "headerNameMatcher": {
          "type": "string",
          "minLength": 1,
          "description": "Regex pattern for header name (e.g., '^content-security-policy$')"
        }
      },
      "required": ["headerNameMatcher"],
      "additionalProperties": false
    },
    "contentMatcherConfig": {
      "type": "object",
      "description": "Matches by content using regex pattern (case-sensitive)",
      "properties": {
        "contentMatcher": {
          "type": "string",
          "minLength": 1,
          "description": "Regex pattern for script content or header value (e.g., 'default-src.*self')"
        }
      },
      "required": ["contentMatcher"],
      "additionalProperties": false
    },
    "hashMatcherConfig": {
      "type": "object",
      "description": "Matches scripts by SHA-256 hash for strict integrity verification",
      "properties": {
        "hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "When this hash was captured"
              },
              "hash": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "description": "SHA-256 hash (64 hex characters)"
                  }
                },
                "required": ["value"],
                "additionalProperties": false
              }
            },
            "required": ["timestamp", "hash"],
            "additionalProperties": false
          }
        }
      },
      "required": ["hashes"],
      "additionalProperties": false
    },
    "orMatcherConfig": {
      "type": "object",
      "description": "Composite matcher implementing OR logic (authorizes if ANY child succeeds)",
      "properties": {
        "orMatcher": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/matcherConfig"
          },
          "description": "Array of child matchers (first-match-wins semantics)"
        },
        "authorisationInfo": {
          "$ref": "#/definitions/authorisationInfo",
          "description": "Optional top-level authorization metadata (overrides child authorization when present)"
        }
      },
      "required": ["orMatcher"],
      "additionalProperties": false
    },
    "andMatcherConfig": {
      "type": "object",
      "description": "Composite matcher implementing AND logic (authorizes only if ALL children succeed)",
      "properties": {
        "andMatcher": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/matcherConfig"
          },
          "description": "Array of child matchers (short-circuit on first failure)"
        },
        "authorisationInfo": {
          "$ref": "#/definitions/authorisationInfo",
          "description": "Optional top-level authorization metadata (overrides child authorization when present)"
        }
      },
      "required": ["andMatcher"],
      "additionalProperties": false
    },
    "matcherConfig": {
      "oneOf": [
        {
          "$ref": "#/definitions/nameMatcherConfig",
          "title": "Name Matcher"
        },
        {
          "$ref": "#/definitions/headerNameMatcherConfig",
          "title": "Header Name Matcher"
        },
        {
          "$ref": "#/definitions/contentMatcherConfig",
          "title": "Content Matcher"
        },
        {
          "$ref": "#/definitions/hashMatcherConfig",
          "title": "Hash Matcher"
        },
        {
          "$ref": "#/definitions/orMatcherConfig",
          "title": "OR Composite Matcher"
        },
        {
          "$ref": "#/definitions/andMatcherConfig",
          "title": "AND Composite Matcher"
        }
      ],
      "description": "Discriminated union of all matcher types (leaf and composite)"
    },
    "authorizeWithConfig": {
      "oneOf": [
        {
          "type": "object",
          "description": "Single matcher with authorization metadata",
          "allOf": [
            {
              "$ref": "#/definitions/matcherConfig"
            },
            {
              "type": "object",
              "properties": {
                "authorisationInfo": {
                  "$ref": "#/definitions/authorisationInfo"
                }
              },
              "required": ["authorisationInfo"]
            }
          ]
        },
        {
          "type": "array",
          "description": "Array syntax (syntactic sugar for OR matcher)",
          "minItems": 1,
          "items": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/definitions/matcherConfig"
              },
              {
                "type": "object",
                "properties": {
                  "authorisationInfo": {
                    "$ref": "#/definitions/authorisationInfo"
                  }
                },
                "required": ["authorisationInfo"]
              }
            ]
          }
        }
      ],
      "description": "Authorization matcher configuration (single or array for OR logic)"
    }
  },
  "type": "object",
  "description": "Inventory entry for script or header authorization",
  "properties": {
    "identifyWith": {
      "$ref": "#/definitions/matcherConfig",
      "description": "Matcher for identifying the resource (script or header)"
    },
    "authoriseWith": {
      "$ref": "#/definitions/authorizeWithConfig",
      "description": "Matcher for authorizing the resource content (single matcher or array for OR)"
    }
  },
  "required": ["identifyWith", "authoriseWith"],
  "additionalProperties": true,
  "examples": [
    {
      "$comment": "Example 1: Simple OR matcher using array syntax",
      "identifyWith": {
        "headerNameMatcher": "^content-security-policy$"
      },
      "authoriseWith": [
        {
          "contentMatcher": "default-src.*self",
          "authorisationInfo": {
            "description": "Strict CSP policy",
            "authorised": true,
            "date": "2025-10-22T12:00:00.000Z"
          }
        },
        {
          "contentMatcher": "default-src.*unsafe-inline",
          "authorisationInfo": {
            "description": "Legacy CSP policy (migration period)",
            "authorised": true,
            "date": "2025-10-22T12:00:00.000Z"
          }
        }
      ]
    },
    {
      "$comment": "Example 2: AND matcher with multiple required directives",
      "identifyWith": {
        "headerNameMatcher": "^content-security-policy$"
      },
      "authoriseWith": {
        "andMatcher": [
          { "contentMatcher": "default-src" },
          { "contentMatcher": "script-src" },
          { "contentMatcher": "connect-src" }
        ],
        "authorisationInfo": {
          "description": "Complete CSP policy with all required directives",
          "authorised": true,
          "date": "2025-10-22T12:00:00.000Z"
        }
      }
    },
    {
      "$comment": "Example 3: Nested composite - OR containing AND",
      "identifyWith": {
        "headerNameMatcher": "^content-security-policy$"
      },
      "authoriseWith": {
        "orMatcher": [
          {
            "andMatcher": [
              { "contentMatcher": "default-src.*self" },
              { "contentMatcher": "script-src.*nonce-" }
            ],
            "authorisationInfo": {
              "description": "Strict CSP with nonce-based scripts",
              "authorised": true,
              "date": "2025-10-22T12:00:00.000Z"
            }
          },
          {
            "andMatcher": [
              { "contentMatcher": "default-src.*unsafe-inline" },
              { "contentMatcher": "report-uri" }
            ],
            "authorisationInfo": {
              "description": "Legacy CSP with reporting enabled",
              "authorised": true,
              "date": "2025-10-22T12:00:00.000Z"
            }
          }
        ],
        "authorisationInfo": {
          "description": "CSP policy - either strict or legacy with reporting",
          "authorised": true,
          "date": "2025-10-22T12:00:00.000Z"
        }
      }
    },
    {
      "$comment": "Example 4: Top-level authorization override (explicit denial)",
      "identifyWith": {
        "headerNameMatcher": "^x-deprecated-header$"
      },
      "authoriseWith": {
        "contentMatcher": ".*",
        "authorisationInfo": {
          "description": "This header is deprecated and should not be used",
          "authorised": false,
          "date": "2025-10-22T12:00:00.000Z"
        }
      }
    }
  ]
}

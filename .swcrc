{
  "$schema": "https://json.schemastore.org/swcrc",
  "jsc": {
    "loose": true,
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "keepClassNames": true,
    "baseUrl": ".",
    "paths": {
      "@modules/*": ["./src/modules/*"]
    }
  },
  "sourceMaps": true,
  "inlineSourcesContent": false,
  "module": {
    "type": "commonjs",
    "ignoreDynamic": true
  },
  "env": {
    "targets": {
      "node": "24"
    }
  }
}

{
  "private": true,
  "name": "pci-dss-page-tampering",
  "version": "0.0.1",
  "description": "PCI DSS compliance system implementing requirements 6.4.3 and 11.6.1 for payment page tampering detection",
  "author": "me&u AU Trading Pty Ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/mr-yum/pci-dss-page-tampering.git"
  },
  "homepage": "https://github.com/mr-yum/pci-dss-page-tampering#readme",
  "bugs": {
    "url": "https://github.com/mr-yum/pci-dss-page-tampering/issues"
  },
  "keywords": [
    "pci-dss",
    "compliance",
    "page-tampering",
    "e-skimming",
    "security"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10",
    "pnpm": "please-use-npm",
    "yarn": "please-use-npm"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "puppeteer": "^24.16.0",
    "simple-git": "^3.28.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.3.100",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.3.0",
    "husky": "^9",
    "jest": "^30.0.0",
    "prettier": "^3.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.36.0"
  },
  "prettier": {
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "tabWidth": 2
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "setup": "husky",
    "clean": "rm -rf dist coverage .swc",
    "precommit": "npm audit --audit-level=high && npm run check:formatting && npm run check:linting && npm run check:typing && npm run test:unit && npm run test:integration",
    "check:formatting": "prettier --check .",
    "fix:formatting": "prettier --write .",
    "check:linting": "eslint .",
    "fix:linting": "eslint --fix .",
    "check:typing": "tsc --noEmit",
    "develop": "swc src -d dist --strip-leading-paths --watch",
    "build:js": "swc src -d dist --strip-leading-paths",
    "validate-inventory": "node dist/utils/inventory/validate-migration.js",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration"
  },
  "license": "MIT"
}
